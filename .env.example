APP_BASE_URL=http://localhost:8000
# Публічна адреса для посилання адмінки (IP VPS: http://123.45.67.89:8000)
ADMIN_PUBLIC_URL=
USE_POLLING=true
APP_ENV=dev
APP_SECRET_KEY=change_me_please
DB_PATH=./bot.db

TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_WEBHOOK_SECRET=replace_me
ADMIN_TELEGRAM_IDS=123456789,476203682
# Група Telegram (id з мінусом), куди бот надсилає нові звернення в підтримку з кнопкою «Перейти до чату»
ADMIN_SUPPORT_NOTIFY_CHAT_ID=

WAYFORPAY_MERCHANT_LOGIN=replace_me
WAYFORPAY_SECRET_KEY=replace_me
WAYFORPAY_RETURN_URL=http://localhost:8000/pay/return
WAYFORPAY_SERVICE_URL=http://localhost:8000/wayforpay/callback
# Статичне посилання на оплату членського внеску (або в адмін → Внески)
WAYFORPAY_MEMBERSHIP_URL=
# Посилання для подій (тест 1 грн): гість і учасник (або в адмін при створенні події)
WAYFORPAY_EVENT_GUEST_URL=
WAYFORPAY_EVENT_MEMBER_URL=

# SendPulse CRM (використайте один із варіантів):
# Варіант 1: статичний API-ключ (Settings → API → API keys)
SENDPULSE_API_KEY=sp_apikey_xxx
# Варіант 2: OAuth (якщо API key не працює)
SENDPULSE_CLIENT_ID=
SENDPULSE_CLIENT_SECRET=
SENDPULSE_ADDRESSBOOK_ID=
# ID тегу в SendPulse для позначення «Потрібно зв'язатись» (коли юзер кинув питання адміну)
SENDPULSE_TAG_CONTACT_ME=
